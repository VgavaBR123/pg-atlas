# Copie este arquivo para ".env" nesta mesma pasta (a pasta de trabalho, fora dos repositórios)
# e preencha os valores. O ".env" nunca é versionado: ele fica só no seu computador.
#
# O pg-atlas lê estas variáveis e conecta em modo somente leitura, com uma única conexão.

PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=

# Opcional: tempo máximo de cada consulta, em milissegundos (padrão 60000)
PG_ATLAS_STATEMENT_TIMEOUT=60000
