{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "aresta": {
      "additionalProperties": false,
      "properties": {
        "confianca": {
          "enum": [
            "confirmado",
            "declarado",
            "hipotese"
          ]
        },
        "destino": {
          "$ref": "#/$defs/extremidade"
        },
        "evidencia": {
          "items": {
            "allOf": [
              {
                "if": {
                  "properties": {
                    "tipo": {
                      "const": "inferencia_codigo"
                    }
                  },
                  "required": [
                    "tipo"
                  ]
                },
                "then": {
                  "properties": {
                    "chave_sem_tenant": {
                      "type": "boolean"
                    },
                    "objetos": {
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "nome": {
                            "type": "string"
                          },
                          "schema": {
                            "type": "string"
                          },
                          "tipo": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "nome",
                          "schema",
                          "tipo"
                        ],
                        "type": "object"
                      },
                      "maxItems": 20,
                      "type": "array"
                    },
                    "tipos_iguais": {
                      "type": "boolean"
                    },
                    "total_objetos": {
                      "minimum": 1,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "chave_sem_tenant",
                    "objetos",
                    "tipos_iguais",
                    "total_objetos"
                  ]
                }
              }
            ],
            "properties": {
              "tipo": {
                "type": "string"
              }
            },
            "required": [
              "tipo"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "fonte": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "nota": {
          "type": [
            "string",
            "null"
          ]
        },
        "origem": {
          "$ref": "#/$defs/extremidade"
        },
        "taxa_casamento": {
          "maximum": 1,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "confianca",
        "destino",
        "evidencia",
        "fonte",
        "id",
        "nota",
        "origem",
        "taxa_casamento"
      ],
      "type": "object"
    },
    "contagens": {
      "additionalProperties": {
        "minimum": 0,
        "type": "integer"
      },
      "type": "object"
    },
    "extremidade": {
      "additionalProperties": false,
      "properties": {
        "colunas": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "relacao": {
          "type": "string"
        },
        "schema": {
          "type": "string"
        }
      },
      "required": [
        "colunas",
        "relacao",
        "schema"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "arestas": {
      "items": {
        "$ref": "#/$defs/aresta"
      },
      "type": "array"
    },
    "resumo": {
      "additionalProperties": false,
      "properties": {
        "fk_declarada": {
          "additionalProperties": false,
          "properties": {
            "autorreferencias": {
              "minimum": 0,
              "type": "integer"
            },
            "entre_schemas": {
              "minimum": 0,
              "type": "integer"
            },
            "not_valid": {
              "minimum": 0,
              "type": "integer"
            },
            "varias_colunas": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "autorreferencias",
            "entre_schemas",
            "not_valid",
            "varias_colunas"
          ],
          "type": "object"
        },
        "inferencia_codigo": {
          "additionalProperties": false,
          "properties": {
            "arestas": {
              "minimum": 0,
              "type": "integer"
            },
            "autojuncao_trivial": {
              "minimum": 0,
              "type": "integer"
            },
            "coluna_inexistente": {
              "minimum": 0,
              "type": "integer"
            },
            "coluna_nao_qualificada": {
              "minimum": 0,
              "type": "integer"
            },
            "comandos_analisados": {
              "minimum": 0,
              "type": "integer"
            },
            "comandos_falhos": {
              "$ref": "#/$defs/contagens"
            },
            "desempata_nome": {
              "minimum": 0,
              "type": "integer"
            },
            "execute_dinamico": {
              "minimum": 0,
              "type": "integer"
            },
            "extrator": {
              "enum": [
                "heuristico",
                "pglast"
              ]
            },
            "fallback_extracao": {
              "$ref": "#/$defs/contagens"
            },
            "igualdades": {
              "minimum": 0,
              "type": "integer"
            },
            "lado_nao_relacao": {
              "minimum": 0,
              "type": "integer"
            },
            "lado_nao_resolvido": {
              "minimum": 0,
              "type": "integer"
            },
            "lado_view": {
              "minimum": 0,
              "type": "integer"
            },
            "objetos_analisados": {
              "$ref": "#/$defs/contagens"
            },
            "objetos_fora": {
              "$ref": "#/$defs/contagens"
            },
            "repetem_fk": {
              "minimum": 0,
              "type": "integer"
            },
            "repetem_nome": {
              "minimum": 0,
              "type": "integer"
            },
            "sem_chave": {
              "minimum": 0,
              "type": "integer"
            },
            "tenant_ignorada": {
              "minimum": 0,
              "type": "integer"
            },
            "um_para_um": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "arestas",
            "autojuncao_trivial",
            "coluna_inexistente",
            "coluna_nao_qualificada",
            "comandos_analisados",
            "comandos_falhos",
            "desempata_nome",
            "execute_dinamico",
            "extrator",
            "fallback_extracao",
            "igualdades",
            "lado_nao_relacao",
            "lado_nao_resolvido",
            "lado_view",
            "objetos_analisados",
            "objetos_fora",
            "repetem_fk",
            "repetem_nome",
            "sem_chave",
            "tenant_ignorada",
            "um_para_um"
          ],
          "type": "object"
        },
        "inferencia_nome": {
          "additionalProperties": false,
          "properties": {
            "arestas": {
              "minimum": 0,
              "type": "integer"
            },
            "calibracao_fk": {
              "additionalProperties": false,
              "properties": {
                "por_regra": {
                  "additionalProperties": {
                    "additionalProperties": false,
                    "properties": {
                      "acerto_ambiguo": {
                        "minimum": 0,
                        "type": "integer"
                      },
                      "acerto_unico": {
                        "minimum": 0,
                        "type": "integer"
                      },
                      "erro": {
                        "minimum": 0,
                        "type": "integer"
                      },
                      "repetem_fk": {
                        "minimum": 0,
                        "type": "integer"
                      }
                    },
                    "required": [
                      "acerto_ambiguo",
                      "acerto_unico",
                      "erro",
                      "repetem_fk"
                    ],
                    "type": "object"
                  },
                  "type": "object"
                },
                "sem_candidato": {
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "por_regra",
                "sem_candidato"
              ],
              "type": "object"
            },
            "colunas_ambiguas": {
              "minimum": 0,
              "type": "integer"
            },
            "colunas_analisadas": {
              "minimum": 0,
              "type": "integer"
            },
            "colunas_com_candidato": {
              "minimum": 0,
              "type": "integer"
            },
            "excluidas_fk": {
              "minimum": 0,
              "type": "integer"
            },
            "excluidas_tenant": {
              "minimum": 0,
              "type": "integer"
            },
            "por_regra": {
              "$ref": "#/$defs/contagens"
            }
          },
          "required": [
            "arestas",
            "calibracao_fk",
            "colunas_ambiguas",
            "colunas_analisadas",
            "colunas_com_candidato",
            "excluidas_fk",
            "excluidas_tenant",
            "por_regra"
          ],
          "type": "object"
        },
        "por_confianca": {
          "$ref": "#/$defs/contagens"
        },
        "por_fonte": {
          "$ref": "#/$defs/contagens"
        },
        "total": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "fk_declarada",
        "por_confianca",
        "por_fonte",
        "total"
      ],
      "type": "object"
    },
    "versao_formato": {
      "const": 1
    }
  },
  "required": [
    "arestas",
    "resumo",
    "versao_formato"
  ],
  "type": "object"
}
